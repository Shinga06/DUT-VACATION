// DUT-AMP database schema (SRS v1.0)
// SQLite for development. Switch `provider` to "postgresql" for production.
// Enum-like fields are Strings; allowed values live in src/lib/constants.ts.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// ───────────────────────── Users, roles, auth (4.1, 3.2) ─────────────────────────

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false) // built-in roles from SRS 3.2
  // Comma-separated permission keys, see src/lib/permissions.ts
  permissions String   @default("")
  users       User[]
  createdAt   DateTime @default(now())
}

model User {
  id               String    @id @default(cuid())
  email            String    @unique
  passwordHash     String
  firstName        String
  lastName         String
  phone            String?
  institution      String? // for institutional coordinators
  roleId           String
  role             Role      @relation(fields: [roleId], references: [id])
  // Scope restriction by residence (null = all residences)
  scopedResidenceId String?
  emailVerified    Boolean   @default(false)
  emailVerifyToken String?
  resetToken       String?
  resetTokenExpiry DateTime?
  isActive         Boolean   @default(true) // FR-007
  failedLogins     Int       @default(0) // FR-006
  lockedUntil      DateTime?
  lastLoginAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  bookings         Booking[]
  auditLogs        AuditLog[]
  loginAttempts    LoginAttempt[]
}

model LoginAttempt {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  email     String
  success   Boolean
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([email, createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id])
  action     String // e.g. "residence.update", "booking.approve"
  entity     String // e.g. "Residence"
  entityId   String?
  before     String? // JSON string of previous values (FR-160)
  after      String? // JSON string of updated values
  ip         String?
  createdAt  DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}

// ───────────────────────── Accommodation inventory (4.2) ─────────────────────────

model Residence {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String
  campus      String?
  address     String?
  latitude    Float?
  longitude   Float?
  facilities  String   @default("") // comma-separated e.g. "Wi-Fi,Kitchen,Laundry"
  photos      String   @default("") // comma-separated URLs
  isActive    Boolean  @default(true)
  rooms       Room[]
  pricing     PricingRule[]
  bookings    Booking[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Room {
  id            String    @id @default(cuid())
  residenceId   String
  residence     Residence @relation(fields: [residenceId], references: [id], onDelete: Cascade)
  roomNumber    String
  floor         String?
  type          String // SINGLE | DOUBLE | SHARING (FR-010)
  capacity      Int       @default(1)
  isAccessible  Boolean   @default(false)
  isActive      Boolean   @default(true) // FR-012
  // AVAILABLE | OCCUPIED | CLEANING | UNDER_MAINTENANCE | OUT_OF_SERVICE (FR-103)
  opStatus      String    @default("AVAILABLE")
  restrictedUntil DateTime? // FR-013 temporary restriction
  restrictionNote String?
  beds          Bed[]
  allocations   Allocation[]
  cleaningTasks CleaningTask[]
  maintenance   MaintenanceRequest[]

  @@unique([residenceId, roomNumber])
}

model Bed {
  id          String   @id @default(cuid())
  roomId      String
  room        Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  label       String // e.g. "A", "B"
  isActive    Boolean  @default(true)
  restrictedUntil DateTime?
  allocations Allocation[]

  @@unique([roomId, label])
}

// ───────────────────────── Pricing (4.3) ─────────────────────────

model PricingRule {
  id           String     @id @default(cuid())
  name         String
  residenceId  String?
  residence    Residence? @relation(fields: [residenceId], references: [id])
  roomType     String? // null = any
  season       String? // JUNE | DECEMBER | INSTITUTIONAL | null
  institution  String?
  event        String?
  pricePerBedPerNight Float // ZAR
  minNights    Int?
  maxNights    Int?
  minGroupSize Int? // group discount threshold
  discountPercent Float @default(0)
  validFrom    DateTime?
  validTo      DateTime?
  isActive     Boolean    @default(true) // FR-019
  priority     Int        @default(0) // higher = more specific/wins
  createdAt    DateTime   @default(now())
}

model BookingPeriod {
  id        String   @id @default(cuid())
  name      String // e.g. "December 2026 Holiday"
  season    String // JUNE | DECEMBER
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(true)
}

// ───────────────────────── Bookings (4.4 - 4.12) ─────────────────────────

model Booking {
  id            String    @id @default(cuid())
  reference     String?   @unique // issued when confirmed (FR-089)
  type          String // PUBLIC | INSTITUTIONAL
  status        String    @default("DRAFT") // FR-058
  paymentStatus String    @default("UNPAID") // separate from status (FR-059)
  userId        String
  user          User      @relation(fields: [userId], references: [id])
  residenceId   String
  residence     Residence @relation(fields: [residenceId], references: [id])
  checkIn       DateTime
  checkOut      DateTime
  occupants     Int
  roomType      String?
  institution   String?
  eventName     String?
  notes         String?
  // Price snapshot - retained when general rates change (FR-020)
  agreedTotal   Float     @default(0)
  amountPaid    Float     @default(0)
  cancellationReason String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  guests        Guest[]
  allocations   Allocation[]
  payments      Payment[]
  preferences   Preference[]
  feedback      Feedback?

  @@index([status])
  @@index([checkIn, checkOut])
}

model Guest {
  id              String   @id @default(cuid())
  bookingId       String
  booking         Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  firstName       String
  lastName        String
  email           String?
  phone           String?
  idNumber        String? // protect (POPIA)
  studentOrStaffNo String?
  institution     String?
  arrivalDate     DateTime? // per-delegate dates (FR-036)
  departureDate   DateTime?
  emergencyName   String?
  emergencyPhone  String?
  rulesAcceptedAt DateTime?
  detailsConfirmedAt DateTime?
  actualArrival   DateTime?
  actualDeparture DateTime?
  allocations     Allocation[]
}

// An allocation reserves a bed for a date range. Overlap checks happen in code
// (src/lib/availability.ts) inside a transaction (FR-014, BR-005).
model Allocation {
  id          String   @id @default(cuid())
  bookingId   String
  booking     Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  roomId      String
  room        Room     @relation(fields: [roomId], references: [id])
  bedId       String?
  bed         Bed?     @relation(fields: [bedId], references: [id])
  guestId     String?
  guest       Guest?   @relation(fields: [guestId], references: [id])
  startDate   DateTime
  endDate     DateTime
  isActive    Boolean  @default(true) // false once released/cancelled
  createdAt   DateTime @default(now())

  @@index([roomId, startDate, endDate])
  @@index([bedId, startDate, endDate])
}

model Preference {
  id        String  @id @default(cuid())
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  kind      String // ROOM_TYPE | SHARING | ACCESSIBILITY | SPECIAL
  details   String
  // PENDING | APPROVED | PARTIALLY_ACCOMMODATED | DECLINED (FR-053)
  status    String  @default("PENDING")
  response  String?
}

// ───────────────────────── Payments (4.10, 4.11) ─────────────────────────

model Payment {
  id          String   @id @default(cuid())
  bookingId   String
  booking     Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  method      String // ONLINE | EFT
  kind        String   @default("PAYMENT") // PAYMENT | REFUND
  amount      Float
  reference   String // booking-specific EFT reference (FR-062)
  proofUrl    String?
  status      String   @default("PENDING") // PENDING | VERIFIED | REJECTED
  verifiedById String?
  verifiedAt  DateTime?
  note        String?
  receiptNo   String?  @unique
  createdAt   DateTime @default(now())
}

model CancellationPolicy {
  id             String @id @default(cuid())
  name           String
  daysBeforeStay Int // cancel at least N days before check-in...
  refundPercent  Float // ...to receive this % back
  isActive       Boolean @default(true)
}

// ───────────────────────── Operations (4.15) ─────────────────────────

model CleaningTask {
  id         String    @id @default(cuid())
  roomId     String
  room       Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  assignedTo String?
  status     String    @default("PENDING") // PENDING | IN_PROGRESS | DONE | INSPECTED | FAILED
  inspectionNote String?
  createdAt  DateTime  @default(now())
  completedAt DateTime?
}

model MaintenanceRequest {
  id          String   @id @default(cuid())
  roomId      String
  room        Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  title       String
  description String?
  priority    String   @default("MEDIUM") // LOW | MEDIUM | HIGH | URGENT
  assignedTo  String?
  status      String   @default("OPEN") // OPEN | IN_PROGRESS | RESOLVED
  createdAt   DateTime @default(now())
  resolvedAt  DateTime?
}

// ───────────────────────── Feedback & notifications (4.17, 4.21) ─────────────────────────

model Feedback {
  id          String  @id @default(cuid())
  bookingId   String  @unique
  booking     Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  rating      Int
  cleanliness Int?
  facilities  Int?
  service     Int?
  comment     String?
  reviewed    Boolean @default(false)
  createdAt   DateTime @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  toEmail   String?
  roleName  String? // role-based admin alerts (FR-146)
  subject   String
  body      String
  channel   String   @default("EMAIL") // EMAIL | DASHBOARD
  status    String   @default("QUEUED") // QUEUED | SENT | FAILED
  readAt    DateTime?
  createdAt DateTime @default(now())
}

model Faq {
  id       String @id @default(cuid())
  question String
  answer   String
  sort     Int    @default(0)
}
